@echo off
chcp 65001
title 全栈项目一键关闭脚本

echo ====================================================
echo  🛑 正在安全关闭 [学生管理系统] 前前后端服务...
echo ====================================================

echo 🗑️ 1. 正在清理 8080 端口 (Java 后端)...
for /f "tokens=5" %%a in ('netstat -ano ^| findstr :8080') do (
    taskkill /f /pid %%a >nul 2>&1
    echo ❌ 成功关闭 PID 为 %%a 的后端进程
)

echo 🗑️ 2. 正在清理 5173 端口 (Vue3 前端)...
for /f "tokens=5" %%a in ('netstat -ano ^| findstr :5173') do (
    taskkill /f /pid %%a >nul 2>&1
    echo ❌ 成功关闭 PID 为 %%a 的前端进程
)

echo ====================================================
echo  🌴 所有服务已安全彻底关闭！今天辛苦了，早点休息！
echo ====================================================
pause